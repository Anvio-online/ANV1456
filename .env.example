# ── Server-only — never prefix these with NEXT_PUBLIC_ ──────────────────────

ANTHROPIC_API_KEY=

DATABASE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RESEND_API_KEY=

SENTRY_AUTH_TOKEN=
SENTRY_DSN=

# ── Public — safe in the client bundle ───────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog — product analytics, funnels, attribution (ADR-0008). The key is
# write-only and safe in the client bundle; posthog-node reuses it server-side.
# Leave blank in dev / preview to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Voice appointment demo (optional)
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VAPI_CALCOM_TOOL_ID=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Private admin — Google OAuth, callback https://anvio.online/api/auth/callback/google
NEXTAUTH_URL=https://anvio.online
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=anshika1307goel@gmail.com
# Audit challenge: create a Turnstile widget for anvio.online (action audit)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signed Resend delivery callbacks: /api/email/webhook
